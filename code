function esc(s){return String(s??'').replace(/[&<>'"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[m]))}
function getFilters(){return{year:document.getElementById('yearFilter').value,country:document.getElementById('countryFilter').value,employee:document.getElementById('employeeFilter').value}}
function filteredTotals(){const f=getFilters();let yearRows=SOURCE.years.slice(), countryRows=SOURCE.countries.slice(), empRows=SOURCE.employees.slice(); if(f.year!=='All'){const y=yearRows.find(r=>String(r.Year)===f.year);yearRows=y?[y]:[]} if(f.country!=='All')countryRows=countryRows.filter(r=>r.Country===f.country); if(f.employee!=='All')empRows=empRows.filter(r=>r.Employee===f.employee); const yearFactor=yearRows.reduce((s,r)=>s+r.Revenue,0)/SOURCE.totalRevenue || 1; const countryFactor=countryRows.reduce((s,r)=>s+r.Revenue,0)/SOURCE.totalRevenue || 1; const empFactor=empRows.reduce((s,r)=>s+r.Revenue,0)/SOURCE.totalRevenue || 1; const factor=Math.min(yearFactor,countryFactor,empFactor); return {revenue:SOURCE.totalRevenue*factor, invoices:Math.round(SOURCE.invoiceCount*factor), qty:Math.round(SOURCE.quantity*factor), customers:Math.max(1,Math.round(SOURCE.customers*factor)), factor};}
