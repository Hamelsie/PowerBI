function renderModel(){modelCards.innerHTML=[['Tables',TABLES.length,'OLTP source'],['Fact rows','2,240','InvoiceLine grain'],['Invoices','412','Header transactions'],['Tracks','3,503','Music product catalog']].map(k=>`<div class="card metric"><div class="label">${k[0]}</div><div class="value">${k[1]}</div><div class="sub">${k[2]}</div></div>`).join('');schemaGrid.innerHTML=TABLES.map(t=>`<div class="schema-table"><div class="schema-head">🧱 ${esc(t.name)} <span class="pill" style="margin-left:auto">${num(t.rows)}</span></div>${t.cols.map(c=>`<div class="schema-row"><span>${esc(c.replace(' PK','').replace(' FK',''))}</span><b>${c.includes('PK')?'PK':c.includes('FK')?'FK':''}</b></div>`).join('')}</div>`).join('');relationshipList.innerHTML=RELS.map(r=>`<div class="rel"><span>${esc(r.split('→')[0].trim())}</span><span class="arrow">→</span><span>${esc(r.split('→')[1].trim())}</span></div>`).join('');sqlPreview.innerHTML=SQLS.fact;}
function showSqlTab(el,key){document.querySelectorAll('#panel-model .tab').forEach(t=>t.classList.remove('active'));el.classList.add('active');sqlPreview.innerHTML=SQLS[key]}
function renderTable(id,data,cols){const el=typeof id==='string'?document.getElementById(id):id;if(!data?.length){el.innerHTML='<tr><td>No data</td></tr>';return;}cols=cols||Object.keys(data[0]);el.innerHTML='<thead><tr>'+cols.map(c=>`<th>${esc(c)}</th>`).join('')+'</tr></thead><tbody>'+data.map(row=>'<tr>'+cols.map(c=>{let v=row[c]; if(typeof v==='number'&&(c.toLowerCase().includes('revenue')||c.toLowerCase().includes('sales')))v=money(v); else if(typeof v==='number')v=num(v); return `<td>${esc(v)}</td>`}).join('')+'</tr>').join('')+'</tbody>'}
