function nav(id){document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));document.querySelectorAll('.nav').forEach(n=>n.classList.remove('active'));document.getElementById('panel-'+id).classList.add('active');[...document.querySelectorAll('.nav')].find(n=>n.getAttribute('onclick')===`nav('${id}')`)?.classList.add('active');const titles={overview:['Executive Overview','Tổng quan doanh thu Chinook từ report mau.pbix, có filter và drill-down.'],replica:['PBIX Report Replica','Dựng lại 5 visual gốc từ trang Analysis trong file mau.pbix.'],model:['Data Model & OLAP','Mô hình Chinook OLTP, relationships, star schema và SQL views.'],query:['SQL Studio','Truy vấn giả lập các OLAP views đã chuẩn hóa.'],explorer:['Data Explorer','Xem các bảng tổng hợp theo quốc gia, năm, nhân viên, khách hàng và thể loại.'],insights:['AI Insights','Luật phân tích tự động để phát hiện thị trường trọng yếu và đề xuất hành động.'],pbi:['Power BI Pack','DAX, Power Query M và mapping visual để đưa vào Power BI.']}; pageTitle.textContent=titles[id][0];pageSub.textContent=titles[id][1]; setTimeout(()=>Object.values(CHARTS).forEach(c=>c?.resize?.()),60)}
function makeChart(id,type,data,options={}){if(CHARTS[id])CHARTS[id].destroy();CHARTS[id]=new Chart(document.getElementById(id),{type,data,options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:options.legend??false}},...options}})}
function renderKPIs(){const t=filteredTotals();const cards=[['Total Sales',money(t.revenue),'Invoice.Total',t.factor>=.8?'up':'warn'],['Invoice Count',num(t.invoices),'Distinct invoices','up'],['Quantity Sold',num(t.qty),'InvoiceLine.Quantity','up'],['Average Order Value',money(t.invoices?t.revenue/t.invoices:0),'Sales / Invoices','warn']]; kpiRow.innerHTML=cards.map(c=>`<div class="card metric"><div class="label">${c[0]}</div><div class="value">${c[1]}</div><div class="sub"><span class="delta ${c[3]}">●</span>${c[2]}</div></div>`).join('')}
function renderCharts(){makeChart('yearChart','line',{labels:SOURCE.years.map(r=>r.Year),datasets:[{label:'Revenue',data:SOURCE.years.map(r=>r.Revenue),tension:.35,fill:true,borderWidth:3,pointRadius:4}]},{scales:{y:{ticks:{callback:v=>'$'+v}},x:{grid:{display:false}}}});makeChart('employeeChart','doughnut',{labels:SOURCE.employees.map(r=>r.Employee),datasets:[{data:SOURCE.employees.map(r=>r.Revenue),borderWidth:2}]},{cutout:'64%',legend:true});makeChart('countryChart','bar',{labels:SOURCE.countries.slice(0,10).map(r=>r.Country),datasets:[{data:SOURCE.countries.slice(0,10).map(r=>r.Revenue),borderWidth:0,borderRadius:8}]},{indexAxis:'y',scales:{x:{ticks:{callback:v=>'$'+v}},y:{grid:{display:false}}}});makeChart('genreChart','bar',{labels:SOURCE.genres.slice(0,8).map(r=>r.Genre),datasets:[{data:SOURCE.genres.slice(0,8).map(r=>r.Revenue),borderWidth:0,borderRadius:8}]},{scales:{y:{ticks:{callback:v=>'$'+v}},x:{ticks:{maxRotation:30,minRotation:0},grid:{display:false}}}});makeChart('gaugeClone','doughnut',{labels:['Actual','Remaining to target'],datasets:[{data:[SOURCE.totalRevenue,Math.max(0,3000-SOURCE.totalRevenue)],circumference:180,rotation:270,borderWidth:0}]},{cutout:'72%',legend:false,plugins:{tooltip:{callbacks:{label:c=>c.label+': '+money(c.raw)}}}});makeChart('riskChart','bar',{labels:SOURCE.countries.slice(0,8).map(r=>r.Country),datasets:[{data:SOURCE.countries.slice(0,8).map(r=>r.Revenue/SOURCE.totalRevenue*100),borderRadius:8}]},{indexAxis:'y',scales:{x:{ticks:{callback:v=>v+'%'}},y:{grid:{display:false}}}})}
function renderTables(){renderTable('topCustomerTable',SOURCE.customers,['CustomerName','Country','Revenue','Invoices','SalesPerson']);const max=SOURCE.countries[0].Revenue;geoList.innerHTML=SOURCE.countries.slice(0,10).map(r=>`<div class="map-row"><b>${esc(r.Country)}</b><div class="barline"><span style="width:${r.Revenue/max*100}%"></span></div><span>${money(r.Revenue)}</span></div>`).join('')}
