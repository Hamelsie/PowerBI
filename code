        <div class="card"><div class="card-title"><h3>Treemap substitute</h3><span>Country → State → City</span></div><div id="treeSubstitute"></div></div>
      </div>
    </section>

    <section id="panel-model" class="panel">
      <div class="grid4" id="modelCards"></div>
      <div class="grid21">
        <div class="card"><div class="card-title"><h3>Chinook OLTP schema</h3><span>11 source tables</span></div><div id="schemaGrid" class="schema"></div></div>
        <div class="card"><div class="card-title"><h3>Relationships</h3><span>PK → FK</span></div><div id="relationshipList"></div></div>
      </div>
      <div class="card"><div class="card-title"><h3>OLAP Star Schema Views</h3><span>SQL Server compatible</span></div><div class="tabs"><button class="tab active" onclick="showSqlTab(this,'fact')">vw_FactSales</button><button class="tab" onclick="showSqlTab(this,'dimcustomer')">vw_DimCustomer</button><button class="tab" onclick="showSqlTab(this,'dimtrack')">vw_DimTrack</button><button class="tab" onclick="showSqlTab(this,'dimdate')">vw_DimDate</button><button class="tab" onclick="showSqlTab(this,'validation')">Validation</button></div><div class="sql" id="sqlPreview"></div></div>
    </section>

    <section id="panel-query" class="panel">
      <div class="card"><div class="card-title"><h3>SQL Studio giả lập theo OLAP views</h3><span>SELECT, WHERE cơ bản</span></div><div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px" id="quickQueries"></div><textarea id="queryText" class="querybox">SELECT * FROM vw_sales_by_country ORDER BY Revenue DESC LIMIT 10;</textarea><div style="display:flex;gap:8px;margin-top:10px"><button class="btn" onclick="runQuery()">Run Query</button><button class="btn secondary" onclick="clearQuery()">Clear</button></div><div id="queryStatus" class="footer-note"></div><div class="table-wrap" style="margin-top:12px"><table id="queryResult"></table></div></div>
    </section>

    <section id="panel-explorer" class="panel">
      <div class="card"><div class="card-title"><h3>Data Explorer</h3><span>Drill-down datasets</span></div><div class="tabs"><button class="tab active" onclick="showDataTab(this,'country')">Sales by Country</button><button class="tab" onclick="showDataTab(this,'year')">Sales by Year</button><button class="tab" onclick="showDataTab(this,'employee')">Sales Person</button><button class="tab" onclick="showDataTab(this,'customer')">Customers</button><button class="tab" onclick="showDataTab(this,'genre')">Genres</button><button class="tab" onclick="showDataTab(this,'quality')">Data Quality</button></div><input id="dataSearch" class="search" placeholder="Tìm trong bảng..." oninput="renderExplorer()" /><div class="table-wrap" style="margin-top:12px"><table id="explorerTable"></table></div></div>
    </section>

    <section id="panel-insights" class="panel">
      <div class="grid3" id="insightCards"></div>
      <div class="grid2">
        <div class="card"><div class="card-title"><h3>AI Recommendation Engine</h3><span>Rule-based analytics</span></div><div id="recommendations"></div></div>
        <div class="card"><div class="card-title"><h3>Revenue concentration risk</h3><span>Market dependence</span></div><div class="chart-box sm"><canvas id="riskChart"></canvas></div></div>
      </div>
      <div class="card"><div class="card-title"><h3>Forecast scenario</h3><span>Next period projection</span></div><div class="table-wrap"><table id="forecastTable"></table></div></div>
    </section>

    <section id="panel-pbi" class="panel">
      <div class="grid2">
        <div class="card"><div class="card-title"><h3>DAX Measures</h3><span>Copy to Power BI</span></div><div class="sql" id="daxBlock"></div></div>
        <div class="card"><div class="card-title"><h3>Power Query M / Connection</h3><span>SQL Server OLAP views</span></div><div class="sql" id="mBlock"></div></div>
      </div>
      <div class="card"><div class="card-title"><h3>Power BI visual mapping</h3><span>From PBIX → upgraded dashboard</span></div><div class="table-wrap"><table id="mappingTable"></table></div></div>
    </section>
  </main>
</div>
