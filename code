const SQLS = {
 fact:`<span class="cm">-- Fact view: one row per invoice line</span>\n<span class="kw">CREATE VIEW</span> vw_FactSales <span class="kw">AS</span>\n<span class="kw">SELECT</span>\n  il.InvoiceLineId,\n  i.InvoiceId,\n  i.CustomerId,\n  il.TrackId,\n  <span class="fn">CAST</span>(<span class="fn">FORMAT</span>(i.InvoiceDate, <span class="st">'yyyyMMdd'</span>) <span class="kw">AS INT</span>) <span class="kw">AS</span> DateKey,\n  il.UnitPrice,\n  il.Quantity,\n  il.UnitPrice * il.Quantity <span class="kw">AS</span> SalesAmount,\n  i.BillingCountry,\n  i.Total <span class="kw">AS</span> InvoiceTotal\n<span class="kw">FROM</span> InvoiceLine il\n<span class="kw">JOIN</span> Invoice i <span class="kw">ON</span> i.InvoiceId = il.InvoiceId;`,
 dimcustomer:`<span class="cm">-- Customer geography dimension</span>\n<span class="kw">CREATE VIEW</span> vw_DimCustomer <span class="kw">AS</span>\n<span class="kw">SELECT</span>\n  c.CustomerId,\n  c.FirstName + <span class="st">' '</span> + c.LastName <span class="kw">AS</span> CustomerName,\n  c.City, c.State, c.Country, c.Email,\n  e.FirstName + <span class="st">' '</span> + e.LastName <span class="kw">AS</span> SalesPerson\n<span class="kw">FROM</span> Customer c\n<span class="kw">LEFT JOIN</span> Employee e <span class="kw">ON</span> e.EmployeeId = c.SupportRepId;`,
 dimtrack:`<span class="cm">-- Track/product dimension</span>\n<span class="kw">CREATE VIEW</span> vw_DimTrack <span class="kw">AS</span>\n<span class="kw">SELECT</span>\n  t.TrackId, t.Name <span class="kw">AS</span> TrackName,\n  al.Title <span class="kw">AS</span> AlbumTitle,\n  ar.Name <span class="kw">AS</span> ArtistName,\n  g.Name <span class="kw">AS</span> GenreName,\n  mt.Name <span class="kw">AS</span> MediaType,\n  t.Milliseconds, t.Bytes, t.UnitPrice\n<span class="kw">FROM</span> Track t\n<span class="kw">LEFT JOIN</span> Album al <span class="kw">ON</span> al.AlbumId=t.AlbumId\n<span class="kw">LEFT JOIN</span> Artist ar <span class="kw">ON</span> ar.ArtistId=al.ArtistId\n<span class="kw">LEFT JOIN</span> Genre g <span class="kw">ON</span> g.GenreId=t.GenreId\n<span class="kw">LEFT JOIN</span> MediaType mt <span class="kw">ON</span> mt.MediaTypeId=t.MediaTypeId;`,
 dimdate:`<span class="cm">-- Date dimension from invoice dates</span>\n<span class="kw">CREATE VIEW</span> vw_DimDate <span class="kw">AS</span>\n<span class="kw">SELECT DISTINCT</span>\n  <span class="fn">CAST</span>(<span class="fn">FORMAT</span>(InvoiceDate, <span class="st">'yyyyMMdd'</span>) <span class="kw">AS INT</span>) <span class="kw">AS</span> DateKey,\n  <span class="fn">CAST</span>(InvoiceDate <span class="kw">AS DATE</span>) <span class="kw">AS</span> FullDate,\n  <span class="fn">YEAR</span>(InvoiceDate) <span class="kw">AS</span> Year,\n  <span class="fn">DATEPART</span>(QUARTER, InvoiceDate) <span class="kw">AS</span> Quarter,\n  <span class="fn">MONTH</span>(InvoiceDate) <span class="kw">AS</span> Month,\n  <span class="fn">DAY</span>(InvoiceDate) <span class="kw">AS</span> Day\n<span class="kw">FROM</span> Invoice;`,
 validation:`<span class="cm">-- Validation checks before Power BI</span>\n<span class="kw">SELECT</span> <span class="fn">SUM</span>(SalesAmount) <span class="kw">AS</span> FactSalesTotal <span class="kw">FROM</span> vw_FactSales;\n\n<span class="kw">SELECT</span> <span class="fn">SUM</span>(UnitPrice * Quantity) <span class="kw">AS</span> SourceSalesTotal <span class="kw">FROM</span> InvoiceLine;\n\n<span class="kw">SELECT</span> <span class="fn">COUNT</span>(*) <span class="kw">AS</span> MissingCustomerKeys\n<span class="kw">FROM</span> vw_FactSales f\n<span class="kw">LEFT JOIN</span> vw_DimCustomer c <span class="kw">ON</span> c.CustomerId=f.CustomerId\n<span class="kw">WHERE</span> c.CustomerId <span class="kw">IS NULL</span>;`
};
const DAX = `<span class="cm">// Core measures</span>\nTotal Sales = <span class="fn">SUM</span>(vw_FactSales[SalesAmount])\nTotal Quantity = <span class="fn">SUM</span>(vw_FactSales[Quantity])\nInvoice Count = <span class="fn">DISTINCTCOUNT</span>(vw_FactSales[InvoiceId])\nAverage Order Value = <span class="fn">DIVIDE</span>([Total Sales], [Invoice Count])\nAverage Unit Price = <span class="fn">DIVIDE</span>([Total Sales], [Total Quantity])\nCustomer Count = <span class="fn">DISTINCTCOUNT</span>(vw_FactSales[CustomerId])\n\n<span class="cm">// Analytical measures</span>\nSales Share % = <span class="fn">DIVIDE</span>([Total Sales], <span class="fn">CALCULATE</span>([Total Sales], <span class="fn">ALL</span>(vw_DimCustomer)))\nYoY Growth % = <span class="fn">DIVIDE</span>([Total Sales] - <span class="fn">CALCULATE</span>([Total Sales], <span class="fn">DATEADD</span>(vw_DimDate[FullDate], -1, YEAR)), <span class="fn">CALCULATE</span>([Total Sales], <span class="fn">DATEADD</span>(vw_DimDate[FullDate], -1, YEAR)))\nTop Country Sales = <span class="fn">MAXX</span>(<span class="fn">TOPN</span>(1, <span class="fn">SUMMARIZE</span>(vw_DimCustomer, vw_DimCustomer[Country], \"Sales\", [Total Sales]), [Sales], DESC), [Sales])`;
const MBLOCK = `<span class="cm">// Power Query example</span>\nlet\n    Source = Sql.Database(<span class="st">"localhost"</span>, <span class="st">"ChinookOLAP"</span>),\n    FactSales = Source{[Schema=<span class="st">"dbo"</span>,Item=<span class="st">"vw_FactSales"</span>]}[Data]\nin\n    FactSales\n\n<span class="cm">// Recommended imported views</span>\nvw_FactSales\nvw_DimCustomer\nvw_DimTrack\nvw_DimDate`;
